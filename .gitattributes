# Fuerza LF en el repo
*           text=auto eol=lf

# Tipos comunes
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.prisma    text eol=lf
*.sql       text eol=lf
