// ==========================================
// CONFIGURACIÓN
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Tipos de Datos Personalizados)
// ==========================================

enum RoleName {
  ADMIN
  CENTRO
  TEACHER
  STUDENT
  PARENT
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

// 👇 NUEVO: Para el flujo de aprobación de alumnos
enum EnrollmentStatus {
  PENDING   // Solicitado, espera aprobación
  ACTIVE    // Aceptado, puede ver contenido
  REJECTED  // Rechazado por el profesor
}

// ==========================================
// MÓDULO DE USUARIOS Y FAMILIA
// ==========================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      RoleName @default(STUDENT)
  isActive  Boolean  @default(true)

  // Multi-centro (v2.0): null solo para ADMIN (rol de plataforma, no pertenece a un centro)
  educationalCenterId Int?
  educationalCenter   EducationalCenter? @relation(fields: [educationalCenterId], references: [id])

  // Relaciones: Tareas
  createdAssignments  Assignment[]  @relation("CreatedBy") // Tareas que el profesor creó
  myAssignments       Assignment[]  @relation("AssignedTo") // Tareas asignadas al alumno (individuales)
  
  // Relaciones: Familia
  children            ParentChild[] @relation("Parent")
  parents             ParentChild[] @relation("Child")

  // Relaciones: Académicas
  enrollments         Enrollment[]  // Materias donde es estudiante
  subjectsTaught      Subject[]     @relation("TeacherSubjects") // Materias que imparte

  // Relaciones: Exámenes
  createdExams       Exam[]            
  examSubmissions    ExamSubmission[] 

  // (Fase 2 - Legacy/Future)
  teachingCourses     Course[]      @relation("TeacherCourses")

  // Mensajería (v2.0)
  conversationsCreated       Conversation[]            @relation("ConversationsCreated")
  conversationsParticipating ConversationParticipant[] @relation("ConversationParticipations")
  messagesSent               Message[]                 @relation("MessagesSent")

  // Notificaciones (v2.0)
  notifications Notification[]

  // Foros por materia (v2.0, Bloque 2)
  forumThreadsCreated ForumThread[] @relation("ForumThreadsCreated")
  forumPostsCreated   ForumPost[]   @relation("ForumPostsCreated")

  // Calificaciones (v2.0, Bloque 3)
  evaluationsReceived Evaluation[] @relation("EvaluationsReceived")
  evaluationsCreated  Evaluation[] @relation("EvaluationsCreated")

  // Asistencia (v2.0, Bloque 4)
  attendanceAsStudent Attendance[] @relation("AttendanceOfStudent")
  attendanceRecorded  Attendance[] @relation("AttendanceRecordedBy")

  // Calendario académico (v2.0, Bloque 5)
  calendarEventsOwned   CalendarEvent[] @relation("CalendarEventsOwned")
  calendarEventsCreated CalendarEvent[] @relation("CalendarEventsCreated")

  // Archivos y documentos (v2.0, Bloque 6)
  documentsUploaded Document[] @relation("DocumentsUploaded")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabla Pivote para relación Mucho-a-Muchos (Padres <-> Hijos)
model ParentChild {
  parentId  Int
  childId   Int
  parent    User @relation("Parent", fields: [parentId], references: [id])
  child     User @relation("Child", fields: [childId], references: [id])

  @@id([parentId, childId])
}

// ==========================================
// MÓDULO ACADÉMICO (CORE)
// ==========================================

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  
  // Código único para unirse (Ej: MAT-101)
  // Senior Note: Debe ser único para evitar conflictos al unirse
  code        String   @unique 
  description String?

  // Profesor Titular
  teacherId   Int
  teacher     User     @relation("TeacherSubjects", fields: [teacherId], references: [id])

  // Multi-centro (v2.0): nullable temporalmente hasta completar el backfill, luego se vuelve NOT NULL
  educationalCenterId Int?
  educationalCenter   EducationalCenter? @relation(fields: [educationalCenterId], references: [id])

  // Relaciones del Sistema
  enrollments Enrollment[]
  assignments Assignment[]
  exams       Exam[]
  forumThreads ForumThread[]
  evaluations Evaluation[]
  attendanceRecords Attendance[]
  calendarEvents CalendarEvent[]
  documents Document[]

  // (Fase 2)
  courses     Course[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enrollment {
  id        Int      @id @default(autoincrement())

  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  // 👇 ESTADO DE LA INSCRIPCIÓN (Control de acceso)
  status    EnrollmentStatus @default(PENDING)
  
  enrolledAt DateTime @default(now())

  // Restricción: Un alumno no puede inscribirse doble a la misma materia
  @@unique([studentId, subjectId]) 
}

// ==========================================
// MÓDULO DE ACTIVIDADES (TAREAS)
// ==========================================

model Assignment {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime
  
  status      AssignmentStatus @default(PENDING) 
  grade       Int?

  // Gestión de Archivos y Entregas
  attachmentUrl     String? // Archivo adjunto por el profesor
  submissionUrl     String? // Archivo entregado por el alumno
  submissionComment String? // Comentario del alumno al entregar
  feedback          String? // Feedback del profesor
  fileUrl           String? // (Legacy/Backup)

  // Relaciones
  subjectId   Int
  subject     Subject @relation(fields: [subjectId], references: [id])

  creatorId   Int
  creator     User    @relation("CreatedBy", fields: [creatorId], references: [id])

  // Asignación específica (Opcional, si es null es para todos los de la materia)
  studentId   Int?    
  student     User?   @relation("AssignedTo", fields: [studentId], references: [id])

  // (Fase 2)
  courseId    Int?
  course      Course? @relation(fields: [courseId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// MÓDULO DE EXÁMENES
// ==========================================

model Exam {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacherId   Int
  teacher     User     @relation(fields: [teacherId], references: [id])
  
  questions   Question[]
  submissions ExamSubmission[]
  
  showResults Boolean  @default(false)
  dueDate     DateTime? 
  duration    Int?      // En minutos
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Question {
  id        Int      @id @default(autoincrement())
  text      String   
  points    Int      @default(1) 
  
  examId    Int
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  options   Option[]
  answers   Answer[] 
}

model Option {
  id        Int      @id @default(autoincrement())
  text      String   
  isCorrect Boolean  @default(false) 
  
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamSubmission {
  id          Int      @id @default(autoincrement())
  
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  
  examId      Int
  exam        Exam     @relation(fields: [examId], references: [id])
  
  score       Float?   
  submittedAt DateTime @default(now())
  
  answers     Answer[]
}

model Answer {
  id               Int            @id @default(autoincrement())
  
  submissionId     Int
  submission       ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  questionId       Int
  question         Question       @relation(fields: [questionId], references: [id])
  
  selectedOptionId Int 
}

// ==========================================
// MÓDULO FUTURE-PROOF (Fase 2)
// ==========================================

model Course {
  id          Int      @id @default(autoincrement())
  name        String   
  description String?
  code        String   @unique 
  
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id])
  
  teacherId   Int
  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  
  assignments Assignment[] 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// ==========================================
// MÓDULO MULTI-CENTRO (v2.0)
// ==========================================

model EducationalCenter {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)

  users         User[]
  subjects      Subject[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MÓDULO DE MENSAJERÍA (v2.0)
// ==========================================

enum ConversationType {
  DIRECT
  GROUP
  ANNOUNCEMENT
}

model Conversation {
  id                  Int              @id @default(autoincrement())
  type                ConversationType
  subject             String?

  // Nullable a propósito: permite hilos "de plataforma" (ADMIN <-> ADMIN o
  // conversaciones donde participan usuarios de más de un centro). El control
  // de acceso real de una conversación es "eres participante", no el centro;
  // esta columna sirve para listados/reportes por centro (ver assertConversationParticipant).
  educationalCenterId Int?
  educationalCenter   EducationalCenter? @relation(fields: [educationalCenterId], references: [id])

  createdById         Int
  createdBy           User              @relation("ConversationsCreated", fields: [createdById], references: [id])

  participants        ConversationParticipant[]
  messages            Message[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([educationalCenterId])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId         Int
  user           User         @relation("ConversationParticipations", fields: [userId], references: [id])

  // Clave para "no leídos" en O(1): en vez de una fila de lectura por mensaje
  lastReadAt     DateTime?
  isArchived     Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                  Int          @id @default(autoincrement())
  conversationId      Int
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId            Int
  sender              User         @relation("MessagesSent", fields: [senderId], references: [id])

  body                String

  // Denormalizado a propósito (ver nota en Conversation.educationalCenterId): nullable por el mismo motivo
  educationalCenterId Int?

  createdAt           DateTime  @default(now())
  editedAt            DateTime?
  deletedAt           DateTime? // soft delete: no rompe el hilo para el resto de participantes

  @@index([conversationId, createdAt])
  @@index([educationalCenterId])

  attachments Document[]
}

// ==========================================
// MÓDULO DE NOTIFICACIONES (v2.0)
// ==========================================

enum NotificationType {
  NEW_MESSAGE
  ANNOUNCEMENT
  TASK_ASSIGNED
  GRADE_PUBLISHED
  FORUM_REPLY
  SYSTEM
}

model Notification {
  id      Int              @id @default(autoincrement())
  userId  Int
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  title   String
  body    String?
  link    String?
  isRead  Boolean          @default(false)

  // Denormalizado igual que en Message/Conversation, mismo motivo: nullable
  // porque un ADMIN de plataforma puede recibir notificaciones sin centro único.
  educationalCenterId Int?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}


// ==========================================
// MÓDULO DE FOROS POR MATERIA (v2.0, Bloque 2)
// ==========================================

model ForumThread {
  id        Int      @id @default(autoincrement())
  title     String
  body      String

  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  authorId  Int
  author    User     @relation("ForumThreadsCreated", fields: [authorId], references: [id])

  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)

  // Denormalizado (mismo motivo que Message/Conversation): filtro de seguridad
  // directo por centro sin depender de un join a Subject en cada query.
  educationalCenterId Int?

  posts     ForumPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, isPinned, updatedAt])
  @@index([educationalCenterId])
}

model ForumPost {
  id       Int         @id @default(autoincrement())

  threadId Int
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId Int
  author   User        @relation("ForumPostsCreated", fields: [authorId], references: [id])

  body     String

  educationalCenterId Int?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime? // soft delete: moderación sin romper el hilo para otros

  @@index([threadId, createdAt])
  @@index([educationalCenterId])
}

// ==========================================
// MÓDULO DE CALIFICACIONES (v2.0, Bloque 3)
// ==========================================

model GradePeriod {
  id        Int      @id @default(autoincrement())
  name      String   // Ej: "Primer Parcial", "2do Trimestre"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  // Nullable: un periodo lo define ADMIN (global) o CENTRO (propio); igual que
  // el resto del denormalizado, nullable no significa "sin dueño", significa
  // "visible a todos" cuando es null (periodo de plataforma).
  educationalCenterId Int?

  evaluations Evaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([educationalCenterId])
}

model Evaluation {
  id        Int      @id @default(autoincrement())

  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  studentId Int
  student   User     @relation("EvaluationsReceived", fields: [studentId], references: [id])

  teacherId Int
  teacher   User     @relation("EvaluationsCreated", fields: [teacherId], references: [id])

  periodId  Int?
  period    GradePeriod? @relation(fields: [periodId], references: [id])

  title   String   // Ej: "Participación en clase", "Proyecto final"
  score   Float    // 0-100
  weight  Float    @default(1) // Peso relativo dentro del promedio de la materia
  comment String?

  // Denormalizado (mismo motivo que Message/ForumThread): filtro directo por
  // centro sin depender de un join a Subject en cada query.
  educationalCenterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, subjectId])
  @@index([educationalCenterId])
}

// ==========================================
// MÓDULO DE ASISTENCIA (v2.0, Bloque 4)
// ==========================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id        Int              @id @default(autoincrement())

  subjectId Int
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  studentId Int
  student   User             @relation("AttendanceOfStudent", fields: [studentId], references: [id])

  // Normalizado a medianoche UTC al grabar (ver attendance.controller.ts):
  // un registro por alumno/materia/día, sin importar la hora de captura.
  date      DateTime

  status    AttendanceStatus

  recordedById Int
  recordedBy   User          @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  comment   String?

  // Denormalizado (mismo motivo que Evaluation/Message): filtro directo por
  // centro sin depender de un join a Subject en cada query.
  educationalCenterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un alumno tiene a lo sumo un registro de asistencia por materia y día
  // (tomar asistencia dos veces el mismo día actualiza el mismo registro).
  @@unique([subjectId, studentId, date])
  @@index([subjectId, date])
  @@index([studentId])
  @@index([educationalCenterId])
}

// ==========================================
// MÓDULO DE CALENDARIO ACADÉMICO (v2.0, Bloque 5)
// ==========================================

enum CalendarEventScope {
  CENTER   // Evento del centro (o global de plataforma si educationalCenterId es null)
  SUBJECT  // Evento de una materia (examen, entrega, clase especial)
  PERSONAL // Evento privado de un usuario, solo él lo ve
}

model CalendarEvent {
  id          Int                @id @default(autoincrement())
  title       String
  description String?
  location    String?

  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean            @default(false)

  scope       CalendarEventScope

  // SUBJECT: la materia a la que pertenece el evento.
  subjectId   Int?
  subject     Subject?           @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // PERSONAL: el dueño exclusivo del evento (solo él lo ve/edita/borra).
  ownerId     Int?
  owner       User?              @relation("CalendarEventsOwned", fields: [ownerId], references: [id])

  createdById Int
  createdBy   User               @relation("CalendarEventsCreated", fields: [createdById], references: [id])

  // Denormalizado (mismo motivo que el resto del módulo v2.0): filtro directo
  // por centro. En eventos CENTER, null = evento global de plataforma (solo ADMIN),
  // igual semántica que GradePeriod.educationalCenterId.
  educationalCenterId Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, startsAt])
  @@index([subjectId, startsAt])
  @@index([ownerId, startsAt])
  @@index([educationalCenterId])
}

// ==========================================
// MÓDULO DE ARCHIVOS Y DOCUMENTOS (v2.0, Bloque 6)
// ==========================================

// Nota: las Tareas (Assignment) YA tenían su propio mecanismo de archivo
// (attachmentUrl/submissionUrl, un solo archivo por fila) desde antes de v2.0 —
// no se tocó, para no romper lo existente. Este modelo cubre lo que faltaba:
// materiales de una materia (varios archivos, con metadata) y adjuntos de
// mensajería (ver messaging.controller.ts).
model Document {
  id           Int      @id @default(autoincrement())

  // Nombre único en disco, generado por el mismo multer.diskStorage que ya
  // usan las Tareas (ver middlewares/upload.middleware.ts) — mismo patrón,
  // misma carpeta /uploads, mismo serving estático.
  filename     String
  originalName String   // nombre original del archivo, para mostrar/descargar
  mimeType     String
  size         Int      // bytes

  uploadedById Int
  uploadedBy   User     @relation("DocumentsUploaded", fields: [uploadedById], references: [id])

  // Exactamente uno de los dos debe estar presente — validado en el
  // controller (documents para materia, o adjunto de un mensaje), no en el
  // schema, para no tener que modelar una tabla polimórfica genérica.
  subjectId    Int?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  messageId    Int?
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Denormalizado (mismo motivo que el resto del módulo v2.0).
  educationalCenterId Int?

  createdAt    DateTime @default(now())

  @@index([subjectId])
  @@index([messageId])
  @@index([educationalCenterId])
}
