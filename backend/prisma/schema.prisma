generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum RoleName {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

// USUARIOS
model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  role     RoleName @default(STUDENT)
  isActive Boolean  @default(true)
  
  // Relaciones Existentes
  createdAssignments  Assignment[]  @relation("CreatedBy") // Tareas creadas (Teacher)
  myAssignments       Assignment[]  @relation("AssignedTo") // Tareas recibidas (Student)
  
  // Relación Padre-Hijo
  children            ParentChild[] @relation("Parent")
  parents             ParentChild[] @relation("Child")

  // 👇 NUEVAS RELACIONES (FASE 2: CURSOS)
  teachingCourses     Course[]      @relation("TeacherCourses") // Cursos que imparte (Teacher)
  enrollments         Enrollment[]  // Cursos donde está inscrito (Student)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdExams       Exam[]            // Exámenes que crea el profesor
  examSubmissions    ExamSubmission[]  // Exámenes que resuelve el estudiante
}

// TABLA PIVOTE PADRE-HIJO
model ParentChild {
  parentId  Int
  childId   Int
  parent    User @relation("Parent", fields: [parentId], references: [id])
  child     User @relation("Child", fields: [childId], references: [id])

  @@id([parentId, childId])
}

// ASIGNATURAS (Ej: Matemáticas, Historia)
model Subject {
  id          Int          @id @default(autoincrement())
  name        String
  
  // Relaciones
  assignments Assignment[] // Mantenemos esto para compatibilidad con tareas viejas
  courses     Course[]     // 👇 Una materia tiene muchos cursos (Matemáticas -> 4to A, 4to B)

  exams       Exam[]       // Exámenes de esta materia
}

// 👇 NUEVO MODELO: CURSO (El Aula Virtual, ej: "Matemáticas 4to A")
model Course {
  id          Int      @id @default(autoincrement())
  name        String   
  description String?
  code        String   @unique // Código único para unirse (ej: MAT-2025-A)
  
  // Relaciones
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id])
  
  teacherId   Int
  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  
  students    Enrollment[] // Estudiantes inscritos
  assignments Assignment[] // Tareas de este curso

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 👇 NUEVO MODELO: MATRÍCULA (Tabla Pivote Estudiante <-> Curso)
model Enrollment {
  studentId Int
  student   User   @relation(fields: [studentId], references: [id])
  
  courseId  Int
  course    Course @relation(fields: [courseId], references: [id])
  
  enrolledAt DateTime @default(now())

  @@id([studentId, courseId]) // Evita que un estudiante se inscriba doble
}

// TAREAS (ASSIGNMENTS) - ACTUALIZADO
model Assignment {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime
  
  status      AssignmentStatus @default(PENDING) 
  
  grade       Int?

  // 📂 ARCHIVOS Y COMENTARIOS
  attachmentUrl     String? 
  submissionUrl     String? 
  submissionComment String? 
  feedback          String? 
  
  fileUrl           String?

  // RELACIONES
  // 👇 CAMBIO IMPORTANTE: Hacemos Subject opcional (?) para transicionar a Course
  subjectId   Int?
  subject     Subject? @relation(fields: [subjectId], references: [id])

  // 👇 NUEVO CAMPO: Relación con Curso (Opcional por ahora para no romper tareas viejas)
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id])

  creatorId   Int
  creator     User     @relation("CreatedBy", fields: [creatorId], references: [id])

  studentId   Int?
  student     User?   @relation("AssignedTo", fields: [studentId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Exam {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  
  // Relaciones
  subjectId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   Int
  teacher     User      @relation(fields: [teacherId], references: [id])
  
  questions   Question[]
  submissions ExamSubmission[]

  // Tiempos
  dueDate     DateTime? // Fecha límite opcional
  duration    Int?      // Duración en minutos (ej: 60 mins)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Question {
  id          Int       @id @default(autoincrement())
  text        String    // "¿Cuánto es 2 + 2?"
  points      Int       @default(1) // Cuánto vale esta pregunta
  
  examId      Int
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  options     Option[]
  answers     Answer[]  // Respuestas de los alumnos a esta pregunta
}

model Option {
  id          Int       @id @default(autoincrement())
  text        String    // "4"
  isCorrect   Boolean   @default(false) // ¿Es la correcta?
  
  questionId  Int
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  // No necesitamos relación inversa a Answer aquí, guardaremos el ID de la opción elegida
}

// Intento/Entrega del Examen
model ExamSubmission {
  id          Int       @id @default(autoincrement())
  
  studentId   Int
  student     User      @relation(fields: [studentId], references: [id])
  
  examId      Int
  exam        Exam      @relation(fields: [examId], references: [id])
  
  score       Float?    // Nota final (Calculada automáticamente)
  submittedAt DateTime  @default(now())
  
  answers     Answer[]
}

// Respuesta individual del alumno
model Answer {
  id            Int       @id @default(autoincrement())
  
  submissionId  Int
  submission    ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  questionId    Int
  question      Question       @relation(fields: [questionId], references: [id])
  
  selectedOptionId Int // La opción que el alumno eligió
}