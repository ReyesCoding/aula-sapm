# Variables para docker-compose.yml en el VPS de producción.
# Copia este archivo a ".env" (sin commitear) y completa los valores reales.

# Cadena de conexión de Neon -- usa el proyecto/rama de PRODUCCIÓN de Neon,
# NUNCA el mismo que usas para desarrollar localmente.
DATABASE_URL="postgresql://usuario:password@tu-proyecto-prod.neon.tech/neondb?sslmode=require"

# Genera uno distinto al de desarrollo, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIA_ESTE_SECRETO_EN_PRODUCCION"
